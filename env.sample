# Copy to .env and adjust. Everything is optional in development:
# without a .env, DEBUG is on, all hosts are allowed, and the Django
# dev secret is used. Production deployments set their own values.

# 0 in production
DJANGO_DEBUG=1

# Generate one: openssl rand -hex 32
DJANGO_SECRET_KEY=

# Comma-separated (defaults to *)
DJANGO_ALLOWED_HOSTS=*

# Needed for the admin over an https proxy, e.g.
# CSRF_TRUSTED_ORIGINS=https://your.domain:443
CSRF_TRUSTED_ORIGINS=

# Audio transcription provider (see backend/core/transcription.py)
TRANSCRIPTION_PROVIDER=gemini

# Defaults to gemini-3.5-transcribe when empty
TRANSCRIPTION_MODEL=

# Required by the gemini provider; without it transcription is skipped
GEMINI_API_KEY=
